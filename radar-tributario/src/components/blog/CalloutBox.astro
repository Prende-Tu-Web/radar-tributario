---
import { PortableText } from 'astro-portabletext';

interface CalloutBoxNode {
  _type: 'calloutBox';
  icon?: string;
  text?: unknown[];
}

interface Props {
  node: CalloutBoxNode;
}

const { node } = Astro.props;
---

<div class="my-6 flex gap-3 rounded-lg border-l-4 border-accent bg-accent/10 p-4">
  <span aria-hidden="true">{node.icon ?? '💡'}</span>
  <div class="text-sm leading-relaxed text-text [&_p]:mb-2 [&_p:last-child]:mb-0">
    <PortableText value={node.text ?? []} />
  </div>
</div>
