---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import { PortableText } from 'astro-portabletext';
import { getPosts, getPostBySlug } from '../../lib/sanity/queries';
import { portableTextComponents } from '../../lib/sanity/portableTextComponents';
import { urlFor } from '../../lib/sanity/image';
import { articleJsonLd } from '../../lib/seo';
import { fieldStyle, titleFieldStyle } from '../../lib/fontStyle';
import type { Post } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post: Post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/noticias/', 404);
}

const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Santiago' }).format(new Date(post.publishedAt))
  : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const bannerUrl = post.coverImage
  ? urlFor(post.coverImage).width(1920).url()
  : null;

/**
 * Punto focal continuo (x%, y%) del título sobre la imagen de portada — reemplaza
 * los antiguos presets discretos izquierda/centro/derecha × arriba/centro/abajo.
 * Espejo de esta misma lógica (zonas, transform, gradiente) en
 * admin-radar-tributario/src/components/PostEditor.tsx (CoverBanner) — mantener sincronizados.
 */
const LEGACY_FOCAL_X: Record<string, number> = { izquierda: 15, centro: 50, derecha: 85 };
const LEGACY_FOCAL_Y: Record<string, number> = { arriba: 20, centro: 50, abajo: 80 };

function legacyToPercent(value: string | undefined, map: Record<string, number>, fallback: number): number {
  if (!value) return fallback;
  return map[value] ?? fallback;
}

const focalX = post.coverImageFocalX ?? legacyToPercent(post.coverImageTitlePosition, LEGACY_FOCAL_X, 15);
const focalY = post.coverImageFocalY ?? legacyToPercent(post.coverImageTitlePositionVertical, LEGACY_FOCAL_Y, 80);

type FocalZoneX = 'izquierda' | 'centro' | 'derecha';
type FocalZoneY = 'arriba' | 'centro' | 'abajo';

function zoneX(x: number): FocalZoneX {
  if (x < 33) return 'izquierda';
  if (x > 67) return 'derecha';
  return 'centro';
}

function zoneY(y: number): FocalZoneY {
  if (y < 33) return 'arriba';
  if (y > 67) return 'abajo';
  return 'centro';
}

const FOCAL_TEXT_ALIGN: Record<FocalZoneX, string> = {
  izquierda: 'text-left items-start',
  centro: 'text-center items-center',
  derecha: 'text-right items-end',
};

const titleAlignClass = FOCAL_TEXT_ALIGN[zoneX(focalX)];
// Zoneado (0% / -50% / -100%) a propósito, a diferencia del preview del
// admin (PostEditor.tsx), que usa translate(-x%, -y%) continuo para que el
// punto no salte mientras se arrastra. Ese continuo es relativo al tamaño
// del propio bloque de texto, así que con un título largo el desplazamiento
// deja de coincidir con "anclado al borde" y el título queda con un padding
// que varía según cuánto texto tenga — bug real reportado en mobile. Acá,
// en el sitio publicado, lo que importa es que el borde quede exactamente
// en el punto elegido, no la suavidad del arrastre.
const FOCAL_TRANSLATE_X: Record<FocalZoneX, string> = { izquierda: '0%', centro: '-50%', derecha: '-100%' };
const FOCAL_TRANSLATE_Y: Record<FocalZoneY, string> = { arriba: '0%', centro: '-50%', abajo: '-100%' };
const titleTransform = `translate(${FOCAL_TRANSLATE_X[zoneX(focalX)]}, ${FOCAL_TRANSLATE_Y[zoneY(focalY)]})`;
// object-cover + aspect-ratio fijo = banner sin barras con cualquier foto; el crop sigue el mismo punto focal del título.
const objectPosition = `${focalX}% ${focalY}%`;
const focalGradient = `radial-gradient(ellipse 130% 110% at ${focalX}% ${focalY}%, rgba(15,37,71,0.88) 0%, rgba(15,37,71,0.5) 45%, rgba(15,37,71,0.12) 75%)`;

const titleStyle = titleFieldStyle(post.titleFontFamily, post.titleFontSize);
const epigrafeStyle = fieldStyle(post.epigrafeFontFamily, post.epigrafeFontSize);
---

<BaseLayout
  title={post.seo?.metaTitle || `${post.title} | Radar Tributario`}
  description={post.seo?.metaDescription || post.summary || post.title}
  ogImage={bannerUrl ?? undefined}
  ogType="article"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(articleJsonLd(post))} />
  <article class="bg-surface">
    {bannerUrl ? (
      <div class="relative w-full overflow-hidden bg-primary">
        <img
          src={bannerUrl}
          alt={post.coverImage?.alt ?? ''}
          class="block aspect-[4/3] w-full object-cover sm:aspect-[2/1] lg:aspect-[12/5]"
          style={{ objectPosition }}
        />
        <div class="absolute inset-0" style={{ background: focalGradient }} />
        <div
          class:list={['absolute flex max-w-[85%] flex-col px-1 lg:max-w-2xl', titleAlignClass]}
          style={{ left: `${focalX}%`, top: `${focalY}%`, transform: titleTransform }}
        >
          {post.category && (
            <a href={`/noticias/categoria/${post.category.slug.current}/`} class="font-body text-[11px] font-semibold uppercase tracking-[0.1em] text-accent hover:text-white">
              {post.category.title}
            </a>
          )}
          {post.epigrafe && (
            <p class="mt-2 font-body text-sm font-semibold text-white/90" style={epigrafeStyle}>{post.epigrafe}</p>
          )}
          <h1 class="mt-3 font-heading text-[2rem] font-medium leading-[1.15] text-white drop-shadow-sm sm:text-[2.5rem]" style={titleStyle}>{post.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-2 font-body text-[13px] text-white/80">
            {post.author && <span>{post.author.name}</span>}
            {post.author && formattedDate && <span aria-hidden="true">·</span>}
            {formattedDate && <span>{formattedDate}</span>}
          </div>
        </div>
      </div>
    ) : null}

    <div
      class:list={[
        // max-w fijo en 7xl (1280px) hacía que pantallas "de por medio" (ej.
        // 1366px, un ancho de laptop muy común) quedaran con casi todo el
        // margen ocupado por el propio contenedor -- se veía apretado ahí
        // aunque en un monitor grande (1920px+) sobraba espacio de sobra a
        // los costados. Se achica el tope en el rango intermedio y solo se
        // abre a 7xl completo desde min-[1920px] en adelante (el tamaño que
        // ya se veía bien), para que la sensación de aire a los costados
        // sea pareja en vez de depender de qué tan ancho sea el monitor.
        'mx-auto max-w-5xl px-2 pb-12 sm:px-3 lg:px-6 lg:pb-16 xl:max-w-6xl 2xl:max-w-7xl 2xl:px-8',
        !bannerUrl && 'pt-12 lg:pt-16',
      ]}
    >
      {!bannerUrl && (
        <>
          {post.category && (
            <a href={`/noticias/categoria/${post.category.slug.current}/`} class="font-body text-[11px] font-semibold uppercase tracking-[0.1em] text-secondary hover:text-primary">
              {post.category.title}
            </a>
          )}
          {post.epigrafe && (
            <p class="mt-2 font-body text-sm font-semibold text-primary" style={epigrafeStyle}>{post.epigrafe}</p>
          )}
          <h1 class="mt-3 font-heading text-[2rem] font-medium leading-[1.15] text-primary sm:text-[2.5rem]" style={titleStyle}>{post.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-2 font-body text-[13px] text-muted">
            {post.author && <span>{post.author.name}</span>}
            {post.author && formattedDate && <span aria-hidden="true">·</span>}
            {formattedDate && <span>{formattedDate}</span>}
          </div>
        </>
      )}

      <div class:list={['flex justify-end', bannerUrl ? 'mt-8' : 'mt-4']}>
        <ShareButtons url={canonicalURL} title={post.title} />
      </div>

      <div class="prose-rt mt-6">
        <PortableText value={post.body ?? []} components={portableTextComponents} />
      </div>

      <div class="mt-10 flex justify-end border-t border-primary/10 pt-6">
        <ShareButtons url={canonicalURL} title={post.title} />
      </div>

      {post.author && (
        <div class="mt-10 border-t border-primary/10 pt-8">
          <AuthorBio author={post.author} />
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .prose-rt :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-primary);
  }
  .prose-rt :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-primary);
  }
  .prose-rt :global(p) {
    margin-bottom: 1.1rem;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-text);
  }
  .prose-rt :global(ul),
  .prose-rt :global(ol) {
    margin-bottom: 1.1rem;
    padding-left: 1.25rem;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-text);
  }
  /*
   * Tailwind v4 preflight resetea `ul`/`ol` a `list-style: none` — sin esto
   * las viñetas/numeración por defecto (tipos "bullet"/"number" del editor
   * embebido, admin-radar-tributario/src/components/BodyEditor/schema.ts)
   * no se veían en el post pese a verse bien en el editor. `.list-arrow`/
   * `.list-check` de abajo ya traen su propio `list-style-type` explícito,
   * así que van después y ganan por orden de cascada (misma especificidad).
   */
  .prose-rt :global(ul) {
    list-style-type: disc;
  }
  .prose-rt :global(ol) {
    list-style-type: decimal;
  }
  .prose-rt :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose-rt :global(strong) {
    color: var(--color-primary);
  }
  .prose-rt :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-rt :global(img) {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }

  /* Viñetas custom del editor embebido (admin-radar-tributario/src/components/BodyEditor/schema.ts) — mantener sincronizados. */
  .prose-rt :global(.list-arrow) {
    list-style-type: "→  ";
  }
  .prose-rt :global(.list-check) {
    list-style-type: "✓  ";
  }
  .prose-rt :global(.list-check > li::marker) {
    color: var(--color-success);
  }
</style>
