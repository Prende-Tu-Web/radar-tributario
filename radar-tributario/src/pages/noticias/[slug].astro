---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import { PortableText } from 'astro-portabletext';
import { getPosts, getPostBySlug } from '../../lib/sanity/queries';
import { portableTextComponents } from '../../lib/sanity/portableTextComponents';
import { urlFor } from '../../lib/sanity/image';
import { articleJsonLd } from '../../lib/seo';
import type { Post } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post: Post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/noticias/', 404);
}

const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Santiago' }).format(new Date(post.publishedAt))
  : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const bannerUrl = post.coverImage
  ? urlFor(post.coverImage).width(1600).height(760).fit('crop').url()
  : null;

const titleHorizontal = post.coverImageTitlePosition ?? 'izquierda';
const titleVertical = post.coverImageTitlePositionVertical ?? 'abajo';

const HORIZONTAL_JUSTIFY: Record<string, string> = {
  izquierda: 'justify-start',
  centro: 'justify-center',
  derecha: 'justify-end',
};
const HORIZONTAL_TEXT_ALIGN: Record<string, string> = {
  izquierda: 'text-left items-start',
  centro: 'text-center items-center',
  derecha: 'text-right items-end',
};
const VERTICAL_ALIGN: Record<string, string> = {
  arriba: 'items-start',
  centro: 'items-center',
  abajo: 'items-end',
};
const VERTICAL_GRADIENT: Record<string, string> = {
  arriba: 'bg-gradient-to-b from-primary/90 via-primary/35 to-transparent',
  centro: 'bg-primary/55',
  abajo: 'bg-gradient-to-t from-primary/90 via-primary/35 to-transparent',
};
const VERTICAL_PADDING: Record<string, string> = {
  arriba: 'pt-8 pb-6 sm:pt-10 lg:pt-14',
  centro: 'py-8',
  abajo: 'pb-8 pt-6 sm:pb-10 lg:pb-14',
};
---

<BaseLayout
  title={post.seo?.metaTitle || `${post.title} | Radar Tributario`}
  description={post.seo?.metaDescription || post.summary || post.title}
  ogImage={bannerUrl ?? undefined}
  ogType="article"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(articleJsonLd(post))} />
  <article class="bg-surface">
    {bannerUrl ? (
      <div class="relative h-[52vh] min-h-[380px] max-h-[560px] w-full overflow-hidden bg-primary">
        <img
          src={bannerUrl}
          alt={post.coverImage?.alt ?? ''}
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class:list={['absolute inset-0', VERTICAL_GRADIENT[titleVertical]]} />
        <div class:list={['absolute inset-0 flex', VERTICAL_ALIGN[titleVertical]]}>
          <div
            class:list={[
              'flex w-full px-4 sm:px-6 md:px-[8%] lg:px-[10%]',
              VERTICAL_PADDING[titleVertical],
              HORIZONTAL_JUSTIFY[titleHorizontal],
            ]}
          >
            <div class:list={['flex max-w-2xl flex-col', HORIZONTAL_TEXT_ALIGN[titleHorizontal]]}>
              {post.category && (
                <a href={`/noticias/categoria/${post.category.slug.current}/`} class="font-body text-[11px] font-semibold uppercase tracking-[0.1em] text-accent hover:text-white">
                  {post.category.title}
                </a>
              )}
              <h1 class="mt-3 font-heading text-[2rem] font-medium leading-[1.15] text-white drop-shadow-sm sm:text-[2.5rem]">{post.title}</h1>
              <div class="mt-4 flex flex-wrap items-center gap-2 font-body text-[13px] text-white/80">
                {post.author && <span>{post.author.name}</span>}
                {post.author && formattedDate && <span aria-hidden="true">·</span>}
                {formattedDate && <span>{formattedDate}</span>}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : null}

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      {!bannerUrl && (
        <>
          {post.category && (
            <a href={`/noticias/categoria/${post.category.slug.current}/`} class="font-body text-[11px] font-semibold uppercase tracking-[0.1em] text-secondary hover:text-primary">
              {post.category.title}
            </a>
          )}
          <h1 class="mt-3 font-heading text-[2rem] font-medium leading-[1.15] text-primary sm:text-[2.5rem]">{post.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-2 font-body text-[13px] text-muted">
            {post.author && <span>{post.author.name}</span>}
            {post.author && formattedDate && <span aria-hidden="true">·</span>}
            {formattedDate && <span>{formattedDate}</span>}
          </div>
        </>
      )}

      <div class:list={['flex justify-end', bannerUrl ? 'mt-8' : 'mt-4']}>
        <ShareButtons url={canonicalURL} title={post.title} />
      </div>

      <div class="prose-rt mt-6">
        <PortableText value={post.body ?? []} components={portableTextComponents} />
      </div>

      <div class="mt-10 flex justify-end border-t border-primary/10 pt-6">
        <ShareButtons url={canonicalURL} title={post.title} />
      </div>

      {post.author && (
        <div class="mt-10 border-t border-primary/10 pt-8">
          <AuthorBio author={post.author} />
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .prose-rt :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-primary);
  }
  .prose-rt :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-primary);
  }
  .prose-rt :global(p) {
    margin-bottom: 1.1rem;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-text);
  }
  .prose-rt :global(ul),
  .prose-rt :global(ol) {
    margin-bottom: 1.1rem;
    padding-left: 1.25rem;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-text);
  }
  .prose-rt :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose-rt :global(strong) {
    color: var(--color-primary);
  }
  .prose-rt :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-rt :global(img) {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }
</style>
