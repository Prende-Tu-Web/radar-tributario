---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { postBySlugQuery } from '../../lib/queries';
import { urlFor } from '../../lib/urlFor';
import { formatDate } from '../../lib/formatDate';
import type { Post } from '../../lib/types';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const post = await sanityClient.fetch<Post | null>(postBySlugQuery, { slug });
if (!post) return Astro.redirect('/404');

const imgUrl = post.coverImage
  ? urlFor(post.coverImage).width(1200).height(630).fit('crop').url()
  : undefined;

const categoryColorMap: Record<string, string> = {
  'rt-tag-red':  'rt-tag rt-tag-red',
  'rt-tag-teal': 'rt-tag rt-tag-teal',
  'rt-tag-navy': 'rt-tag rt-tag-navy',
};
const tagClass = categoryColorMap[post.category?.color ?? ''] ?? 'rt-tag rt-tag-navy';

const canonicalUrl = `https://radartributario.cl/noticias/${slug}/`;

const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: post.seo?.metaTitle ?? post.title,
    description: post.seo?.metaDescription ?? post.summary,
    url: canonicalUrl,
    ...(imgUrl ? { image: [imgUrl] } : {}),
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    inLanguage: 'es-CL',
    author: post.author
      ? { '@type': 'Person', name: post.author.name, url: `https://radartributario.cl/autor/${post.author.slug?.current}/` }
      : undefined,
    publisher: {
      '@type': 'Organization',
      name: 'Radar Tributario',
      url: 'https://radartributario.cl',
      logo: { '@type': 'ImageObject', url: 'https://radartributario.cl/logo.png' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://radartributario.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Noticias', item: 'https://radartributario.cl/noticias/' },
      { '@type': 'ListItem', position: 3, name: post.title, item: canonicalUrl },
    ],
  },
];

interface Span { _type: 'span'; text: string; marks?: string[] }
interface MarkDef { _key: string; _type: string; href?: string }
interface Block {
  _type: 'block';
  _key: string;
  style?: string;
  listItem?: 'bullet' | 'number';
  markDefs?: MarkDef[];
  children?: Span[];
}
interface ImageBlock {
  _type: 'image';
  _key: string;
  asset?: { _ref: string };
  alt?: string;
  caption?: string;
}
interface CalloutBlock {
  _type: 'calloutBox';
  _key: string;
  icon?: string;
  text?: Block[];
}
interface RecommendationCardsBlock {
  _type: 'recommendationCards';
  _key: string;
  items?: { icon?: string; text: string }[];
}
interface ComparisonTableBlock {
  _type: 'comparisonTable';
  _key: string;
  title?: string;
  columns?: string[];
  rows?: { cells: { text?: string; indicator?: 'check' | 'cross' | 'none' }[] }[];
}
type BodyItem = Block | ImageBlock | CalloutBlock | RecommendationCardsBlock | ComparisonTableBlock;
type ListGroup = { _type: 'list'; listItem: 'bullet' | 'number'; items: Block[] };

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function renderInline(children: Span[] = [], markDefs: MarkDef[] = []): string {
  return children
    .map((span) => {
      let html = escapeHtml(span.text);
      const marks = span.marks ?? [];
      if (marks.includes('strong')) html = `<strong>${html}</strong>`;
      if (marks.includes('em')) html = `<em>${html}</em>`;
      const linkKey = marks.find((m) => markDefs.some((d) => d._key === m && d._type === 'link'));
      if (linkKey) {
        const href = markDefs.find((d) => d._key === linkKey)?.href ?? '#';
        html = `<a href="${escapeHtml(href)}" target="_blank" rel="noopener">${html}</a>`;
      }
      return html;
    })
    .join('');
}

function groupListItems(body: BodyItem[]): (BodyItem | ListGroup)[] {
  const grouped: (BodyItem | ListGroup)[] = [];
  for (const item of body) {
    const isListBlock = item._type === 'block' && Boolean((item as Block).listItem);
    const last = grouped[grouped.length - 1];
    if (isListBlock) {
      const listItem = (item as Block).listItem!;
      if (last && last._type === 'list' && last.listItem === listItem) {
        last.items.push(item as Block);
      } else {
        grouped.push({ _type: 'list', listItem, items: [item as Block] });
      }
    } else {
      grouped.push(item);
    }
  }
  return grouped;
}
---

<BaseLayout
  title={post.seo?.metaTitle ?? post.title}
  description={post.seo?.metaDescription ?? post.summary}
  canonical={post.seo?.canonical ?? canonicalUrl}
  noIndex={post.seo?.noIndex}
  ogImage={imgUrl}
  jsonLd={articleJsonLd}
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-rt-muted mb-6" style="font-family:'Montserrat',sans-serif;">
      <a href="/" class="hover:text-rt-red transition-colors">Inicio</a>
      <span>/</span>
      <a href="/noticias/" class="hover:text-rt-red transition-colors">Noticias</a>
    </nav>

    <!-- Categoría + importancia -->
    <div class="flex items-center gap-2 mb-4">
      {post.category && (
        <a href={`/categoria/${post.category.slug.current}/`} class={tagClass}>
          {post.category.name}
        </a>
      )}
      {post.importance === 'urgente'   && <span class="rt-tag rt-tag-red">Urgente</span>}
      {post.importance === 'destacado' && <span class="rt-tag rt-tag-teal">Destacado</span>}
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-rt-navy leading-tight mb-4" style="font-family:'Rubik',sans-serif;">
      {post.title}
    </h1>

    {post.summary && (
      <p class="text-lg text-rt-muted leading-relaxed mb-6 border-l-4 border-rt-teal pl-4">
        {post.summary}
      </p>
    )}

    <!-- Byline -->
    <div class="flex items-center gap-4 text-sm text-rt-muted mb-8 pb-6 border-b border-rt-border" style="font-family:'Montserrat',sans-serif;">
      {post.author && <span class="font-medium text-rt-text">{post.author.name}</span>}
      {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
    </div>

    <!-- Imagen destacada -->
    {imgUrl && (
      <figure class="mb-8 -mx-4 md:mx-0">
        <img src={imgUrl} alt={post.title} class="w-full object-cover max-h-[460px]" />
      </figure>
    )}

    <!-- Cuerpo del artículo -->
    {post.body && (
      <div class="prose prose-slate max-w-none text-rt-text">
        {groupListItems(post.body as BodyItem[]).map((entry) => {
          if (entry._type === 'list') {
            const itemsHtml = entry.items.map((b) => renderInline(b.children, b.markDefs));
            return entry.listItem === 'number' ? (
              <ol class="list-decimal pl-5 mb-4 space-y-1 text-rt-muted">
                {itemsHtml.map((html) => <li set:html={html} />)}
              </ol>
            ) : (
              <ul class="list-disc pl-5 mb-4 space-y-1 text-rt-muted">
                {itemsHtml.map((html) => <li set:html={html} />)}
              </ul>
            );
          }

          if (entry._type === 'block') {
            const html = renderInline(entry.children, entry.markDefs);
            if (!html) return null;
            if (entry.style === 'h2') return <h2 class="font-bold text-2xl text-rt-navy mt-8 mb-4 leading-snug" style="font-family:'Rubik',sans-serif;" set:html={html} />;
            if (entry.style === 'h3') return <h3 class="font-semibold text-xl text-rt-navy mt-6 mb-3 leading-snug" style="font-family:'Rubik',sans-serif;" set:html={html} />;
            if (entry.style === 'blockquote') return <blockquote class="border-l-4 border-rt-teal pl-4 my-6 text-rt-muted italic" set:html={html} />;
            return <p class="text-rt-muted leading-relaxed mb-4" set:html={html} />;
          }

          if (entry._type === 'image' && entry.asset) {
            let src: string | null = null;
            try {
              src = urlFor(entry).width(900).fit('max').url();
            } catch {
              src = null;
            }
            if (!src) return null;
            return (
              <figure class="my-6 -mx-4 md:mx-0">
                <img src={src} alt={entry.alt ?? ''} class="w-full object-cover" />
                {entry.caption && <figcaption class="text-xs text-rt-muted mt-2 text-center">{entry.caption}</figcaption>}
              </figure>
            );
          }

          if (entry._type === 'calloutBox') {
            const html = (entry.text ?? [])
              .map((b) => renderInline(b.children, b.markDefs))
              .filter(Boolean)
              .join(' ');
            if (!html) return null;
            return (
              <div class="flex gap-3 rounded p-4 my-6" style="background:rgba(34,224,196,.08); border-left:3px solid var(--rt-teal);">
                <span aria-hidden="true">{entry.icon ?? '💡'}</span>
                <div class="text-sm leading-relaxed text-rt-text" set:html={html} />
              </div>
            );
          }

          if (entry._type === 'recommendationCards') {
            return (
              <div class="grid sm:grid-cols-2 gap-3 my-6">
                {(entry.items ?? []).map((card) => (
                  <div class="flex items-start gap-2 rounded p-3" style="background:#f8fafc; border:1px solid var(--rt-border);">
                    <span aria-hidden="true">{card.icon ?? '✅'}</span>
                    <span class="text-sm text-rt-text">{card.text}</span>
                  </div>
                ))}
              </div>
            );
          }

          if (entry._type === 'comparisonTable') {
            return (
              <div class="my-6 overflow-x-auto">
                {entry.title && <p class="font-semibold text-rt-navy mb-2">{entry.title}</p>}
                <table class="w-full text-sm border-collapse">
                  <thead>
                    <tr>
                      {(entry.columns ?? []).map((col) => (
                        <th class="text-left p-2" style="background:var(--rt-navy); color:white;">{col}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {(entry.rows ?? []).map((row) => (
                      <tr>
                        {row.cells.map((cell) => (
                          <td class="p-2 border-b" style="border-color:var(--rt-border);">
                            {cell.indicator === 'check' && <span style="color:var(--rt-teal);">✓</span>}
                            {cell.indicator === 'cross' && <span style="color:var(--rt-red);">✕</span>}
                            {cell.text && <span class={cell.indicator && cell.indicator !== 'none' ? 'ml-1' : ''}>{cell.text}</span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          }

          return null;
        })}
      </div>
    )}

    <!-- Tags -->
    {post.tags && post.tags.length > 0 && (
      <div class="mt-10 pt-6 border-t border-rt-border">
        <p class="text-xs font-semibold uppercase tracking-widest text-rt-muted mb-3" style="font-family:'Montserrat',sans-serif;">Temas</p>
        <div class="flex flex-wrap gap-2">
          {post.tags.map(tag => (
            <a href={`/tag/${tag.slug.current}/`} class="rt-tag bg-rt-bg text-rt-muted border border-rt-border hover:border-rt-navy hover:text-rt-navy transition-colors">
              {tag.name}
            </a>
          ))}
        </div>
      </div>
    )}

  </article>
</BaseLayout>
